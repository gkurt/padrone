{
  "name": "@padrone/tasks-example",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "module": "src/tasks.ts",
  "exports": {
    ".": "./src/tasks.ts"
  },
  "bin": "src/tasks.ts",
  "scripts": {
    "start": "bun --conditions=padrone@dev src/tasks.ts",
    "ai": "bun --conditions=padrone@dev run src/ai.ts",
    "dev": "bun --conditions=padrone@dev run --watch src/tasks.ts"
  },
  "dependencies": {
    "ai": "^7.0.118",
    "ink": "^7.1.1",
    "padrone": "workspace:*",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0"
  }
}
