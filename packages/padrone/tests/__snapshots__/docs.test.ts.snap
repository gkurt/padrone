// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`docs generateDocs markdown snapshot for show command 1`] = `
"# show

## Usage

\`\`\`
padrone-test show <id> [options]
\`\`\`

## Arguments

- \`id\` *(string)* — Task ID

## Options

#### \`--priority\`

Priority level

**Type:** \`string\` | **Default:** \`medium\` | **Choices:** \`low\`, \`medium\`, \`high\`

#### \`--verbose\`

Show detailed information
"
`;

