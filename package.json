{
  "name": "@padrone/root",
  "version": "2.1.0",
  "type": "module",
  "private": true,
  "description": "Create interactive CLI apps with Zod schemas",
  "homepage": "https://gkurt.com/padrone/",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gkurt/padrone.git"
  },
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://gkurt.com"
  },
  "workspaces": [
    ".",
    "docs",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "example": "bun --filter=@padrone/example start",
    "start": "bun --filter=padrone start",
    "docs": "bun --filter=padrone-docs start",
    "test": "bun test --conditions=padrone@dev",
    "typecheck": "tsgo",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "fix": "biome check --write",
    "checks": "bun check && bun run test && bun typecheck",
    "prepare": "husky",
    "tegami": "bun scripts/tegami.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tegami": "^1.5.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
