{
  "name": "padrone",
  "version": "3.0.0",
  "description": "Create type-safe, interactive CLI apps with Zod schemas",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "keywords": [
    "cli",
    "command-line",
    "zod",
    "typescript",
    "type-safe",
    "parser",
    "arguments",
    "options",
    "ai",
    "vercel-ai",
    "standard-schema"
  ],
  "homepage": "https://github.com/gkurt/padrone",
  "bugs": {
    "url": "https://github.com/gkurt/padrone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/padrone.git"
  },
  "author": {
    "name": "Gokhan Kurt",
    "email": "gokhan@gkurt.com",
    "url": "https://gkurt.com"
  },
  "files": [
    "dist/",
    "src/",
    "media/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "padrone": "./src/cli/index.ts"
  },
  "imports": {
    "#*": "./*"
  },
  "exports": {
    ".": {
      "padrone@dev": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "source": "./src/index.ts"
    },
    "./test": {
      "padrone@dev": "./src/test.ts",
      "import": {
        "types": "./dist/test.d.mts",
        "default": "./dist/test.mjs"
      },
      "source": "./src/test.ts"
    },
    "./codegen": {
      "padrone@dev": "./src/codegen/index.ts",
      "import": {
        "types": "./dist/codegen/index.d.mts",
        "default": "./dist/codegen/index.mjs"
      },
      "source": "./src/codegen/index.ts"
    },
    "./docs": {
      "padrone@dev": "./src/docs/index.ts",
      "import": {
        "types": "./dist/docs/index.d.mts",
        "default": "./dist/docs/index.mjs"
      },
      "source": "./src/docs/index.ts"
    },
    "./zod": {
      "padrone@dev": "./src/zod.ts",
      "import": {
        "types": "./dist/zod.d.mts",
        "default": "./dist/zod.mjs"
      },
      "source": "./src/zod.ts"
    },
    "./ink": {
      "padrone@dev": "./src/ink.ts",
      "import": {
        "types": "./dist/ink.d.mts",
        "default": "./dist/ink.mjs"
      },
      "source": "./src/ink.ts"
    },
    "./mcp": {
      "padrone@dev": "./src/mcp.ts",
      "import": {
        "types": "./dist/mcp.d.mts",
        "default": "./dist/mcp.mjs"
      },
      "source": "./src/mcp.ts"
    },
    "./serve": {
      "padrone@dev": "./src/serve.ts",
      "import": {
        "types": "./dist/serve.d.mts",
        "default": "./dist/serve.mjs"
      },
      "source": "./src/serve.ts"
    },
    "./tracing": {
      "padrone@dev": "./src/tracing.ts",
      "import": {
        "types": "./dist/tracing.d.mts",
        "default": "./dist/tracing.mjs"
      },
      "source": "./src/tracing.ts"
    },
    "./completion": {
      "padrone@dev": "./src/completion.ts",
      "import": {
        "types": "./dist/completion.d.mts",
        "default": "./dist/completion.mjs"
      },
      "source": "./src/completion.ts"
    },
    "./man": {
      "padrone@dev": "./src/man.ts",
      "import": {
        "types": "./dist/man.d.mts",
        "default": "./dist/man.mjs"
      },
      "source": "./src/man.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/test.ts src/zod.ts src/ink.ts src/mcp.ts src/serve.ts src/tracing.ts src/completion.ts src/man.ts src/codegen/index.ts src/docs/index.ts --dts --sourcemap --unbundle",
    "start": "bun --conditions=padrone@dev src/cli/index.ts",
    "dev": "bun --conditions=padrone@dev --watch src/cli/index.ts",
    "test": "bun test --conditions=padrone@dev",
    "link": "bun start link",
    "unlink": "bun start unlink",
    "prepack": "bun run build && bun ../../scripts/prepareForRelease.ts"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "enquirer": "^2.4.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "ai": "^7.0.118",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "tsdown": "^0.23.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "ai": "5 || 6 || 7",
    "ink": "^6.0.0 || ^7.0.0",
    "react": ">=18.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "ink": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
